# Local-first configuration. Copy this file to .env and adjust only as needed.
LLM_PROVIDER=ollama
VECTOR_PROVIDER=local_chroma
EMBEDDING_PROVIDER=local_bge

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
BASE_DATA_DIR=./data
DEBUG_RAG=false

# Optional cloud providers. Leave blank when using the local setup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
INLINE_MODEL_API_KEY=
INLINE_MODEL_BASE_URL=
INLINE_MODEL_NAME=
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
CHROMA_HOST=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
GITHUB_TOKEN=
